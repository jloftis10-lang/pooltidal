---
import Icon from './Icon.astro';
import { BUSINESS } from '../lib/business';

const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/services/weekly-cleaning-maintenance', label: 'Weekly Pool Service' },
  { href: '/services/pool-repair', label: 'Pool Repair' },
  { href: '/locations', label: 'Service Areas' },
  { href: '/pool-service-cost', label: 'Pool Service Cost Calculator' },
  { href: '/pool-volume-calculator', label: 'Pool Volume Calculator' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<div class="md:hidden">
  <button
    id="mobile-menu-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
    aria-label="Open menu"
    class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-lg border border-line text-ink"
  >
    <Icon name="menu" class="h-6 w-6" />
  </button>

  <div id="mobile-menu-backdrop" aria-hidden="true" class="fixed inset-0 z-40 hidden bg-ink/40"></div>

  <div
    id="mobile-menu-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
    aria-hidden="true"
    inert
    class="fixed inset-y-0 right-0 z-50 flex w-full max-w-xs translate-x-full flex-col bg-surface shadow-xl transition-transform duration-200 ease-out"
  >
    <div class="flex items-center justify-between border-b border-line px-6 py-4">
      <span class="font-display text-lg font-semibold text-primary">Menu</span>
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Close menu"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-ink hover:bg-canvas"
      >
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>

    <nav class="flex flex-1 flex-col gap-1 overflow-y-auto px-4 py-4">
      {
        navLinks.map((link) => (
          <a href={link.href} class="rounded-lg px-3 py-3 text-base font-medium text-ink hover:bg-canvas">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="space-y-3 border-t border-line px-4 py-4">
      <a
        href="/contact"
        onclick="window.trackEvent && window.trackEvent('quote_cta_click')"
        class="block rounded-full bg-accent-strong px-6 py-3 text-center text-sm font-semibold text-white"
      >
        Get a Pool Service Quote
      </a>
      <a
        href={BUSINESS.phoneHref}
        onclick="window.trackEvent && window.trackEvent('phone_click')"
        class="block rounded-full border border-line px-6 py-3 text-center text-sm font-semibold text-ink"
      >
        Call {BUSINESS.phone}
      </a>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('mobile-menu-trigger');
  const panel = document.getElementById('mobile-menu-panel');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const closeBtn = document.getElementById('mobile-menu-close');

  if (trigger && panel && backdrop && closeBtn) {
    const focusableSelector = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        closeMenu();
        return;
      }
      if (e.key === 'Tab') {
        const focusables = Array.from(panel!.querySelectorAll<HTMLElement>(focusableSelector));
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    function openMenu() {
      lastFocused = document.activeElement as HTMLElement;
      panel!.classList.remove('translate-x-full');
      panel!.removeAttribute('inert');
      panel!.setAttribute('aria-hidden', 'false');
      backdrop!.classList.remove('hidden');
      trigger!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      const first = panel!.querySelector<HTMLElement>(focusableSelector);
      first?.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function closeMenu() {
      panel!.classList.add('translate-x-full');
      panel!.setAttribute('inert', '');
      panel!.setAttribute('aria-hidden', 'true');
      backdrop!.classList.add('hidden');
      trigger!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      lastFocused?.focus();
    }

    trigger.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  }
</script>
