---
import Icon from './Icon.astro';
import { REGION_LABELS, type Location } from '../lib/locations';

interface Props {
  location: Location;
}

const { location } = Astro.props;
---

<a
  href={`/locations/${location.slug}`}
  class="group flex flex-col gap-2 rounded-2xl border border-line bg-surface p-5 transition hover:border-primary hover:shadow-sm"
>
  <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted-soft">
    <Icon name="map-pin" class="h-4 w-4" />
    {REGION_LABELS[location.region]}
  </span>
  <h3 class="font-display text-lg font-semibold text-ink group-hover:text-primary">{location.name}</h3>
  <span class="text-sm font-medium text-primary">Pool service in {location.name} &rarr;</span>
</a>
