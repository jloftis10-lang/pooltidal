---
import Icon from './Icon.astro';
import { POOLSAVR, getPoolSavrUrl, type PoolSavrSource } from '../lib/poolsavr';

interface Props {
  source: PoolSavrSource;
  heading?: string;
  body?: string;
  compact?: boolean;
}

const {
  source,
  heading = 'Planning a larger pool project?',
  body = 'For resurfacing, tile, coping, decking, or a broader renovation, use PoolSavr to start a project estimate. Pool Tidal remains your local contact for cleaning, repair, and equipment service.',
  compact = false,
} = Astro.props;
---

<aside class:list={['rounded-2xl border border-line bg-canvas', compact ? 'p-5' : 'p-6']}>
  <p class="text-xs font-semibold uppercase tracking-wide text-primary">Pool remodeling &amp; project planning</p>
  <h2 class:list={['font-display font-semibold text-ink', compact ? 'mt-2 text-base' : 'mt-2 text-lg']}>
    {heading}
  </h2>
  <p class="mt-2 text-sm text-muted">{body}</p>
  <div class="mt-4 flex flex-wrap items-center gap-4">
    <a
      href={getPoolSavrUrl(source)}
      target="_blank"
      rel="noopener noreferrer"
      onclick={`window.trackEvent && window.trackEvent('poolsavr_cta_click', { source: '${source}' })`}
      class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-dark"
    >
      Start a Remodel Cost Estimate
      <Icon name="external-link" class="h-4 w-4 flex-shrink-0" />
    </a>
    <a href="/remodel" class="text-sm font-medium text-primary hover:text-primary-dark">
      See when PoolSavr is the right fit &rarr;
    </a>
  </div>
  <p class="mt-3 text-xs text-muted-soft">
    Opens {POOLSAVR.name}, a separate site and company under common ownership.
  </p>
</aside>
