---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={`/blog/${post.id}`}
  class="group flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6 transition hover:border-primary hover:shadow-sm"
>
  <span class="text-xs font-semibold uppercase tracking-wide text-muted-soft">{formattedDate}</span>
  <h2 class="font-display text-xl font-semibold text-ink group-hover:text-primary">{post.data.title}</h2>
  <p class="text-sm text-muted">{post.data.description}</p>
  <span class="mt-auto text-sm font-medium text-primary">Read more &rarr;</span>
</a>
