---
import { BUSINESS } from '../lib/business';
import { HEADER_LOGO } from '../lib/branding';
import Icon from './Icon.astro';
import MobileMenu from './MobileMenu.astro';

const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/pool-service-cost', label: 'Cost Calculator' },
  { href: '/locations', label: 'Service Areas' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
    <a href="/" class="flex-shrink-0">
      <img
        src={HEADER_LOGO}
        alt={`${BUSINESS.name} — Pool Service — San Diego, CA`}
        class="h-14 w-auto md:h-16"
        width="1117"
        height="855"
      />
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-sm font-medium text-ink hover:text-primary">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={BUSINESS.phoneHref}
        onclick="window.trackEvent && window.trackEvent('phone_click')"
        aria-label={`Call ${BUSINESS.phone}`}
        class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-primary text-white hover:bg-primary-dark sm:h-auto sm:w-auto sm:gap-2 sm:px-4 sm:py-2"
      >
        <Icon name="phone" class="h-5 w-5 sm:hidden" />
        <span class="hidden text-sm font-semibold sm:inline">{BUSINESS.phone}</span>
      </a>
      <MobileMenu />
    </div>
  </div>
</header>
