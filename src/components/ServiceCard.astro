---
import Icon from './Icon.astro';
import type { Service } from '../lib/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={`/services/${service.slug}`}
  class="group flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6 transition hover:border-primary hover:shadow-sm"
>
  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-canvas text-primary">
    <Icon name={service.icon} class="h-5 w-5" />
  </span>
  <h3 class="font-display text-lg font-semibold text-ink group-hover:text-primary">{service.name}</h3>
  <p class="text-sm text-muted">{service.shortDesc}</p>
  <span class="mt-auto text-sm font-medium text-primary">Learn more &rarr;</span>
</a>
