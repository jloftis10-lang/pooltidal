---
import { BUSINESS } from '../lib/business';
import { SERVICES } from '../lib/services';
import { LOCATIONS } from '../lib/locations';
import { FOOTER_LOGO } from '../lib/branding';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
// Priority (featured) cities first, so the footer surfaces the same cities
// that have richer local-SEO content, then fill the rest by list order.
const featuredLocations = [...LOCATIONS]
  .sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)))
  .slice(0, 10);
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-4">
    <div>
      <img
        src={FOOTER_LOGO}
        alt={`${BUSINESS.name} — Pool Service — San Diego, CA`}
        class="h-24 w-auto"
        width="1117"
        height="855"
      />
      <p class="mt-4 text-sm">
        <a
          href={BUSINESS.phoneHref}
          onclick="window.trackEvent && window.trackEvent('phone_click')"
          class="font-medium text-ink hover:text-primary"
        >
          {BUSINESS.phone}
        </a>
      </p>
      <p class="text-sm">
        <a
          href={BUSINESS.emailHref}
          onclick="window.trackEvent && window.trackEvent('email_click')"
          class="font-medium text-ink hover:text-primary"
        >
          {BUSINESS.email}
        </a>
      </p>
      {
        BUSINESS.licenseNumber && (
          <p class="mt-2 text-xs text-muted-soft">License #{BUSINESS.licenseNumber}</p>
        )
      }
      {
        BUSINESS.address && (
          <p class="text-xs text-muted-soft">
            {BUSINESS.address.streetAddress}, {BUSINESS.address.addressLocality},{' '}
            {BUSINESS.address.addressRegion} {BUSINESS.address.postalCode}
          </p>
        )
      }
      {
        BUSINESS.googleBusinessUrl && (
          <a
            href={BUSINESS.googleBusinessUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 block text-xs font-medium text-primary hover:text-primary-dark"
          >
            View us on Google &rarr;
          </a>
        )
      }
      <div class="mt-4 flex items-center gap-2">
        <a
          href={BUSINESS.twitterUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${BUSINESS.name} on X`}
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink hover:border-primary hover:text-primary"
        >
          <Icon name="x" class="h-4 w-4" />
        </a>
        <a
          href={BUSINESS.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${BUSINESS.name} on Instagram`}
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink hover:border-primary hover:text-primary"
        >
          <Icon name="instagram" class="h-4 w-4" />
        </a>
        <a
          href={BUSINESS.facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${BUSINESS.name} on Facebook`}
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink hover:border-primary hover:text-primary"
        >
          <Icon name="facebook" class="h-4 w-4" />
        </a>
        <a
          href={BUSINESS.tiktokUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${BUSINESS.name} on TikTok`}
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink hover:border-primary hover:text-primary"
        >
          <Icon name="tiktok" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">Services</p>
      <ul class="mt-3 space-y-2">
        {
          SERVICES.map((service) => (
            <li>
              <a href={`/services/${service.slug}`} class="text-sm text-muted hover:text-primary">
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">Service Areas</p>
      <ul class="mt-3 space-y-2">
        {
          featuredLocations.map((location) => (
            <li>
              <a href={`/locations/${location.slug}`} class="text-sm text-muted hover:text-primary">
                {location.name}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/locations" class="mt-3 inline-block text-sm font-medium text-primary hover:text-primary-dark">
        View all {LOCATIONS.length} areas &rarr;
      </a>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">Company</p>
      <ul class="mt-3 space-y-2">
        <li><a href="/blog" class="text-sm text-muted hover:text-primary">Blog</a></li>
        <li>
          <a href="/pool-volume-calculator" class="text-sm text-muted hover:text-primary">
            Pool Volume Calculator
          </a>
        </li>
        <li>
          <a href="/remodel" class="text-sm text-muted hover:text-primary">
            Pool Remodeling (PoolSavr)
          </a>
        </li>
        <li><a href="/about" class="text-sm text-muted hover:text-primary">About</a></li>
        <li><a href="/contact" class="text-sm text-muted hover:text-primary">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line px-6 py-6 text-center text-xs text-muted-soft">
    &copy; {year} {BUSINESS.name}. Serving {BUSINESS.serviceRegion}.
  </div>
</footer>
