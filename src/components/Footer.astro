---
import { BUSINESS } from '../lib/business';
import { SERVICES } from '../lib/services';
import { LOCATIONS } from '../lib/locations';

const year = new Date().getFullYear();
const featuredLocations = LOCATIONS.slice(0, 10);
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-4">
    <div>
      <p class="font-display text-lg font-semibold text-primary">{BUSINESS.name}</p>
      <p class="mt-2 text-sm text-muted">{BUSINESS.tagline}</p>
      <p class="mt-4 text-sm">
        <a href={BUSINESS.phoneHref} class="font-medium text-ink hover:text-primary">{BUSINESS.phone}</a>
      </p>
      <p class="text-sm">
        <a href={BUSINESS.emailHref} class="font-medium text-ink hover:text-primary">{BUSINESS.email}</a>
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">Services</p>
      <ul class="mt-3 space-y-2">
        {
          SERVICES.map((service) => (
            <li>
              <a href={`/services/${service.slug}`} class="text-sm text-muted hover:text-primary">
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">Service Areas</p>
      <ul class="mt-3 space-y-2">
        {
          featuredLocations.map((location) => (
            <li>
              <a href={`/locations/${location.slug}`} class="text-sm text-muted hover:text-primary">
                {location.name}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/locations" class="mt-3 inline-block text-sm font-medium text-primary hover:text-primary-dark">
        View all {LOCATIONS.length} areas &rarr;
      </a>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">Company</p>
      <ul class="mt-3 space-y-2">
        <li><a href="/about" class="text-sm text-muted hover:text-primary">About</a></li>
        <li><a href="/contact" class="text-sm text-muted hover:text-primary">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line px-6 py-6 text-center text-xs text-muted-soft">
    &copy; {year} {BUSINESS.name}. Serving {BUSINESS.serviceRegion}.
  </div>
</footer>
