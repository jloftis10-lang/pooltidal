---
import { BUSINESS } from '../lib/business';

interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Ready for a pool you never have to think about?',
  subheading = 'Tell us your address and we\'ll put together a service plan for your pool.',
} = Astro.props;
---

<section class="bg-primary">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-16 text-center">
    <h2 class="font-display text-2xl font-semibold text-white md:text-3xl">{heading}</h2>
    <p class="max-w-xl text-white/90">{subheading}</p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/contact"
        class="rounded-full bg-accent-strong px-6 py-3 text-sm font-semibold text-white hover:opacity-90"
      >
        Get a Free Quote
      </a>
      <a
        href={BUSINESS.phoneHref}
        class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10"
      >
        Call {BUSINESS.phone}
      </a>
    </div>
  </div>
</section>
