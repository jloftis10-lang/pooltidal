---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PHOTO_SLOTS } from '../lib/photo-slots';

interface Props {
  heading?: string;
}

const { heading } = Astro.props;

// Eagerly globs real photography dropped into src/assets/photos/. Files are
// matched to a slot by filename prefix (e.g. finished-pools-01.jpg matches
// the "finished-pools" slot below) — see IMAGE-GUIDE.md for the naming
// convention. A slot with no matching file simply doesn't render; this must
// never fall back to stock or placeholder imagery.
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const groups = PHOTO_SLOTS.map((slot) => {
  const images = Object.entries(photoModules)
    .filter(([path]) => path.split('/').pop()?.startsWith(slot.id))
    .map(([, mod]) => mod.default);
  return { slot, images };
}).filter((group) => group.images.length > 0);
---

{
  groups.length > 0 && (
    <section>
      {heading && <h2 class="font-display text-xl font-semibold text-ink">{heading}</h2>}
      <div class="mt-6 grid gap-10">
        {groups.map((group) => (
          <div>
            <h3 class="font-display text-lg font-semibold text-ink">{group.slot.label}</h3>
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.images.map((img) => (
                <Picture
                  src={img}
                  alt={group.slot.label}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[400, 640, 800]}
                  sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw"
                  width={800}
                  height={600}
                  loading="lazy"
                  class="rounded-2xl object-cover shadow-sm"
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}
