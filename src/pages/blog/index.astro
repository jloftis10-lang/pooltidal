---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import CTASection from '../../components/CTASection.astro';

const CLUSTERS = ['Pool Remodeling & Projects', 'Pool Maintenance', 'Pool Equipment', 'Pool Problems', 'San Diego Pool Care'] as const;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const groups = CLUSTERS.map((cluster) => ({
  cluster,
  posts: posts.filter((post) => post.data.cluster === cluster),
})).filter((group) => group.posts.length > 0);
---

<Layout
  title="Pool Care Tips & Advice | Pool Tidal Blog"
  description="Practical San Diego pool maintenance, repair, equipment, and remodeling-planning guidance from Pool Tidal."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <span class="text-sm font-semibold uppercase tracking-wide text-primary">Blog</span>
    <h1 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">Pool care tips & advice</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Practical guidance on keeping your pool healthy, catching problems early, and planning larger
      pool projects — from a San Diego pool-service perspective.
    </p>

    {
      groups.map((group) => (
        <div class="mt-14 first:mt-10">
          <h2 class="font-display text-xl font-semibold text-ink">{group.cluster}</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.posts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <CTASection />
</Layout>
