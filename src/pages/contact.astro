---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS } from '../lib/business';
import { LOCATIONS } from '../lib/locations';
import { SERVICES } from '../lib/services';

// Contact form posts to FormSubmit (https://formsubmit.co) — a no-backend
// form relay that emails submissions to BUSINESS.email. The FIRST
// submission triggers a one-time "activate this form" confirmation email
// that must be clicked before further submissions deliver.
const formAction = `https://formsubmit.co/${BUSINESS.email}`;
---

<Layout
  title="Contact Pool Tidal | Get a Free Pool Service Quote"
  description="Get a free pool cleaning, repair, or service quote from Pool Tidal. Serving San Diego County."
>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <span class="text-sm font-semibold uppercase tracking-wide text-primary">Contact</span>
    <h1 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">Get a free quote</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Tell us about your pool and where you're located, and we'll follow up with a plan and pricing.
    </p>

    <div class="mt-10 grid gap-10 md:grid-cols-5">
      <form action={formAction} method="POST" class="space-y-4 md:col-span-3">
        <input type="hidden" name="_subject" value="New quote request from www.pooltidal.com" />
        <input type="hidden" name="_captcha" value="true" />
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-ink">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-ink focus:border-primary focus:outline-none"
            />
          </div>
          <div>
            <label for="phone" class="text-sm font-medium text-ink">Phone</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-ink focus:border-primary focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label for="email" class="text-sm font-medium text-ink">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-ink focus:border-primary focus:outline-none"
          />
        </div>

        <div>
          <label for="location" class="text-sm font-medium text-ink">City</label>
          <select
            id="location"
            name="location"
            required
            class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-ink focus:border-primary focus:outline-none"
          >
            <option value="">Select your city</option>
            {LOCATIONS.map((location) => <option value={location.name}>{location.name}</option>)}
          </select>
        </div>

        <div>
          <label for="service" class="text-sm font-medium text-ink">What do you need?</label>
          <select
            id="service"
            name="service"
            required
            class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-ink focus:border-primary focus:outline-none"
          >
            <option value="">Select a service</option>
            {SERVICES.map((service) => <option value={service.name}>{service.name}</option>)}
            <option value="Not sure">Not sure yet</option>
          </select>
        </div>

        <div>
          <label for="message" class="text-sm font-medium text-ink">Anything else we should know?</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2 text-ink focus:border-primary focus:outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark"
        >
          Request a Quote
        </button>
      </form>

      <div class="space-y-4 md:col-span-2">
        <div class="rounded-2xl border border-line bg-surface p-6">
          <div class="flex items-center gap-3">
            <Icon name="phone" class="h-5 w-5 text-primary" />
            <a href={BUSINESS.phoneHref} class="font-medium text-ink hover:text-primary">{BUSINESS.phone}</a>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <Icon name="mail" class="h-5 w-5 text-primary" />
            <a href={BUSINESS.emailHref} class="font-medium text-ink hover:text-primary">{BUSINESS.email}</a>
          </div>
        </div>
        <div class="rounded-2xl border border-line bg-surface p-6 text-sm text-muted">
          Serving {LOCATIONS.length} cities and communities across {BUSINESS.serviceRegion}.
          <a href="/locations" class="mt-2 block font-medium text-primary hover:text-primary-dark">
            See all service areas &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
