---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import LocationCard from '../components/LocationCard.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import PoolWaterBackground from '../components/PoolWaterBackground.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import poolShowcase from '../assets/images/san-diego-backyard-pool-clear-water.webp';
import { SERVICES, getService } from '../lib/services';
import { LOCATIONS } from '../lib/locations';
import { BUSINESS } from '../lib/business';
import { DIFFERENTIATORS } from '../lib/differentiators';
import { POOLSAVR } from '../lib/poolsavr';

const featuredLocations = LOCATIONS.slice(0, 8);
const weeklyService = getService('weekly-cleaning-maintenance');

const highlights = [
  'Locally based, serving San Diego County',
  'Clear, itemized pricing before any repair work',
  'Consistent route service, not a rotating crew',
  'Weekly cleaning plans, repairs, and equipment upgrades',
];

const steps = [
  {
    title: 'Tell us about your pool',
    description: 'Share your address, pool size, and what you need — weekly service, a repair, or a one-time cleaning.',
  },
  {
    title: 'We assess what it needs',
    description: 'We review the details — and take a look in person when it matters — to figure out the right plan for your pool.',
  },
  {
    title: 'Pool Tidal handles the ongoing care',
    description: "Your route gets scheduled and your technician takes it from there — testing, balancing, and flagging anything that needs attention.",
  },
];
---

<Layout
  title="Pool Tidal | San Diego Pool Cleaning, Repair & Service"
  description="Pool Tidal provides weekly pool cleaning, repair, and equipment installation across San Diego County — from Carlsbad to Chula Vista. Get a free quote."
>
  <section class="relative overflow-hidden">
    <PoolWaterBackground />

    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 md:grid-cols-2 md:py-28">
      <div>
        <span class="text-sm font-semibold uppercase tracking-wide text-white/80">
          {BUSINESS.serviceRegion}
        </span>
        <h1 class="mt-3 font-display text-4xl font-semibold leading-tight text-white md:text-5xl">
          Pool care you don't have to think about.
        </h1>
        <p class="mt-4 text-lg text-white/85">
          Reliable weekly pool cleaning, repairs, and equipment service throughout San Diego County —
          with straightforward communication and dependable service, visit after visit.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/contact"
            onclick="window.trackEvent && window.trackEvent('quote_cta_click', { location: 'hero' })"
            class="rounded-full bg-accent-strong px-6 py-3 text-sm font-semibold text-white hover:opacity-90"
          >
            Get a Pool Service Quote
          </a>
          <a
            href={BUSINESS.phoneHref}
            onclick="window.trackEvent && window.trackEvent('phone_click', { location: 'hero' })"
            class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10"
          >
            Call {BUSINESS.phone}
          </a>
        </div>
      </div>

      <ul class="grid gap-4 rounded-2xl border border-white/25 bg-white/10 p-6 backdrop-blur-sm">
        {
          highlights.map((item) => (
            <li class="flex items-start gap-3 text-sm text-white">
              <Icon name="check" class="mt-0.5 h-5 w-5 flex-shrink-0 text-white" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <TrustStrip />

  {
    weeklyService && (
      <section class="bg-surface">
        <div class="mx-auto max-w-6xl px-6 py-16">
          <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
            <div>
              <span class="text-sm font-semibold uppercase tracking-wide text-primary">Our Core Service</span>
              <h2 class="mt-3 font-display text-2xl font-semibold text-ink md:text-3xl">
                Everything your pool needs, every week.
              </h2>
              <p class="mt-4 text-muted">
                Most of our customers are on weekly recurring service, and it's what we build our
                routes around. The goal is pool ownership that takes zero effort on your end — no
                remembering to test chemicals, no guessing why the water looks off, no discovering a
                problem after it's already an expensive one.
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-4">
                <a
                  href="/services/weekly-cleaning-maintenance"
                  onclick="window.trackEvent && window.trackEvent('service_cta_click', { service: 'weekly-cleaning-maintenance', location: 'homepage-core' })"
                  class="inline-block rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark"
                >
                  See Weekly Service Details
                </a>
                <a
                  href="/pool-service-cost"
                  onclick="window.trackEvent && window.trackEvent('cost_calculator_started', { location: 'homepage-core-link' })"
                  class="text-sm font-medium text-primary hover:text-primary-dark"
                >
                  Not sure what it costs? Try the cost calculator &rarr;
                </a>
              </div>
            </div>
            <ul class="grid gap-3 sm:grid-cols-2">
              {weeklyService.bullets.map((bullet) => (
                <li class="flex items-start gap-2 rounded-xl border border-line bg-canvas p-3 text-sm text-ink">
                  <Icon name="check" class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" />
                  {bullet}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="text-center">
      <span class="text-sm font-semibold uppercase tracking-wide text-primary">Why Pool Tidal</span>
      <h2 class="mt-3 font-display text-2xl font-semibold text-ink md:text-3xl">
        What working with us actually looks like
      </h2>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        DIFFERENTIATORS.map((item) => (
          <div class="rounded-2xl border border-line bg-surface p-5 text-center">
            <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-canvas text-primary">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-3 font-display text-base font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm text-muted">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center">
      <span class="text-sm font-semibold uppercase tracking-wide text-primary">How It Works</span>
      <h2 class="mt-3 font-display text-2xl font-semibold text-ink md:text-3xl">Getting started is simple</h2>

      <div class="mt-10 grid gap-8 sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <div>
              <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary font-display text-lg font-semibold text-white">
                {i + 1}
              </span>
              <h3 class="mt-4 font-display text-lg font-semibold text-ink">{step.title}</h3>
              <p class="mt-2 text-sm text-muted">{step.description}</p>
            </div>
          ))
        }
      </div>

      <a
        href="/contact"
        onclick="window.trackEvent && window.trackEvent('quote_cta_click', { location: 'how-it-works' })"
        class="mt-10 inline-block rounded-full bg-accent-strong px-6 py-3 text-sm font-semibold text-white hover:opacity-90"
      >
        Get a Pool Service Quote
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div>
        <span class="text-sm font-semibold uppercase tracking-wide text-primary">The Standard</span>
        <h2 class="mt-3 font-display text-2xl font-semibold text-ink md:text-3xl">
          Clear water, every time you look at it
        </h2>
        <p class="mt-4 text-muted">
          Not just right after a special cleaning — this is what consistent care is supposed to
          look like on an ordinary day. Balanced chemistry, a clean surface, and equipment that's
          actually keeping up.
        </p>
      </div>
      <Picture
        src={poolShowcase}
        alt="A clear, well-maintained backyard pool with an ocean view in San Diego County"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[400, 640, 800, 1100, 1536]}
        sizes="(min-width: 768px) 532px, 100vw"
        width={1536}
        height={1024}
        class="rounded-2xl object-cover shadow-lg"
      />
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-2xl font-semibold text-ink md:text-3xl">What we do</h2>
          <p class="mt-2 text-muted">From routine cleanings to full equipment replacement.</p>
        </div>
        <a href="/services" class="text-sm font-medium text-primary hover:text-primary-dark">
          View all services &rarr;
        </a>
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {SERVICES.map((service) => <ServiceCard service={service} />)}
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-line bg-canvas p-6">
        <div>
          <p class="font-display text-base font-semibold text-ink">{POOLSAVR.navLabel}</p>
          <p class="mt-1 text-sm text-muted">
            Pool Tidal doesn't do full remodels — for that, our sister company {POOLSAVR.name} can
            measure your pool and get you a quick, free estimate.
          </p>
        </div>
        <a
          href={POOLSAVR.url}
          target="_blank"
          rel="noopener noreferrer"
          onclick="window.trackEvent && window.trackEvent('remodel_cta_click', { location: 'homepage-services' })"
          class="inline-flex flex-shrink-0 items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark"
        >
          Get a Free Remodel Estimate
          <Icon name="external-link" class="h-4 w-4 flex-shrink-0" />
        </a>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink md:text-3xl">Where we service</h2>
        <p class="mt-2 text-muted">
          Serving {LOCATIONS.length} cities and communities across San Diego County.
        </p>
      </div>
      <a href="/locations" class="text-sm font-medium text-primary hover:text-primary-dark">
        View all {LOCATIONS.length} areas &rarr;
      </a>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {featuredLocations.map((location) => <LocationCard location={location} />)}
    </div>
  </section>

  <CTASection heading="Ready for a pool you never have to think about?" subheading="Tell us your address and we'll put together a service plan for your pool." />
</Layout>
