---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CTASection from '../../components/CTASection.astro';
import BlogCard from '../../components/BlogCard.astro';
import PoolSavrCTA from '../../components/PoolSavrCTA.astro';
import { SERVICES } from '../../lib/services';
import { LOCATIONS } from '../../lib/locations';
import { BUSINESS } from '../../lib/business';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
const sampleLocations = LOCATIONS.slice(0, 12);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = service.relatedPosts
  .map((slug) => allPosts.find((post) => post.id === slug))
  .filter((post): post is (typeof allPosts)[number] => Boolean(post));

const quoteHref = `/contact?service=${service.slug}`;
const serviceUrl = `${BUSINESS.siteUrl}/services/${service.slug}`;
const poolSavrSource = service.slug === 'pool-repair'
  ? 'service_pool_repair'
  : service.slug === 'equipment-installation'
    ? 'service_equipment_installation'
    : undefined;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: BUSINESS.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${BUSINESS.siteUrl}/services` },
    { '@type': 'ListItem', position: 3, name: service.name, item: serviceUrl },
  ],
};
---

<Layout title={`${service.name} | Pool Tidal`} description={service.shortDesc}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <nav class="text-sm text-muted">
      <a href="/" class="hover:text-primary">Home</a> /
      <a href="/services" class="hover:text-primary">Services</a> /
      <span class="text-ink">{service.name}</span>
    </nav>

    <div class="mt-4 flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-canvas text-primary">
        <Icon name={service.icon} class="h-6 w-6" />
      </span>
      <h1 class="font-display text-3xl font-semibold text-ink md:text-4xl">{service.name}</h1>
    </div>

    <p class="mt-6 text-lg text-muted">{service.longDesc}</p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href={quoteHref}
        onclick={`window.trackEvent && window.trackEvent('service_cta_click', { service: '${service.slug}', location: 'service-hero' })`}
        class="rounded-full bg-accent-strong px-6 py-3 text-sm font-semibold text-white hover:opacity-90"
      >
        Get a Pool Service Quote
      </a>
      <a
        href={BUSINESS.phoneHref}
        onclick={`window.trackEvent && window.trackEvent('phone_click', { location: 'service-hero' })`}
        class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink hover:border-primary hover:text-primary"
      >
        <Icon name="phone" class="h-4 w-4 flex-shrink-0" />
        Call {BUSINESS.phone}
      </a>
    </div>


    <h2 class="mt-12 font-display text-xl font-semibold text-ink">What's included</h2>
    <ul class="mt-4 space-y-3">
      {
        service.bullets.map((bullet) => (
          <li class="flex items-start gap-3 text-ink">
            <Icon name="check" class="mt-0.5 h-5 w-5 flex-shrink-0 text-primary" />
            {bullet}
          </li>
        ))
      }
    </ul>

    <h2 class="mt-12 font-display text-xl font-semibold text-ink">Why it matters</h2>
    <p class="mt-4 text-muted">{service.whyItMatters}</p>

    {
      poolSavrSource && (
        <div class="mt-10">
          <PoolSavrCTA
            source={poolSavrSource}
            heading="Is this repair part of a larger renovation?"
            body="Pool Tidal can diagnose and handle standalone repairs and equipment work. If your plans also include resurfacing, tile, coping, decking, or a broader remodel, PoolSavr provides a separate project-estimate path."
          />
        </div>
      )
    }

    <div class="mt-10 rounded-2xl border border-line bg-surface p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Available across San Diego County</h2>
      <p class="mt-2 text-sm text-muted">
        We provide {service.name.toLowerCase()} in San Diego and surrounding communities, including:
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          sampleLocations.map((location) => (
            <a
              href={`/locations/${location.slug}`}
              onclick={`window.trackEvent && window.trackEvent('location_cta_click', { location: '${location.slug}', service: '${service.slug}' })`}
              class="rounded-full border border-line px-3 py-1 text-sm text-ink hover:border-primary hover:text-primary"
            >
              {location.name}
            </a>
          ))
        }
      </div>
      <a href="/locations" class="mt-4 inline-block text-sm font-medium text-primary hover:text-primary-dark">
        View all {LOCATIONS.length} service areas &rarr;
      </a>
    </div>

    <div class="mt-12">
      <h2 class="font-display text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-4 divide-y divide-line rounded-2xl border border-line bg-surface">
        {
          service.faqs.map((faq) => (
            <details class="group p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-ink marker:content-none">
                {faq.question}
                <Icon
                  name="chevron-down"
                  class="h-5 w-5 flex-shrink-0 text-primary transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-3 text-sm text-muted">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>

    {
      relatedPosts.length > 0 && (
        <div class="mt-12">
          <h2 class="font-display text-lg font-semibold text-ink">Related reading</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {relatedPosts.map((post) => <BlogCard post={post} />)}
          </div>
        </div>
      )
    }

    <div class="mt-12">
      <h2 class="font-display text-lg font-semibold text-ink">Other services</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {
          otherServices.map((other) => (
            <a
              href={`/services/${other.slug}`}
              class="rounded-xl border border-line bg-surface p-4 text-sm font-medium text-ink hover:border-primary hover:text-primary"
            >
              {other.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    heading={`Ready to get started with ${service.name.toLowerCase()}?`}
    ctaHref={quoteHref}
    trackingLocation="service-footer"
  />
</Layout>
