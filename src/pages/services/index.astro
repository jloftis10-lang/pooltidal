---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';
import { SERVICES } from '../../lib/services';
---

<Layout
  title="Pool Services | Pool Tidal"
  description="Weekly pool cleaning, repair, equipment installation, and green pool recovery across San Diego County."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <span class="text-sm font-semibold uppercase tracking-wide text-primary">Services</span>
    <h1 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">Pool care, top to bottom</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Whether you need a weekly visit, a one-time repair, or a full equipment upgrade, we cover it —
      across every community we serve in San Diego County.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {SERVICES.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <CTASection />
</Layout>
