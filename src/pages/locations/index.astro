---
import Layout from '../../layouts/Layout.astro';
import LocationCard from '../../components/LocationCard.astro';
import CTASection from '../../components/CTASection.astro';
import { LOCATIONS, REGION_LABELS, type Region } from '../../lib/locations';

const regionOrder: Region[] = ['central', 'coastal-north', 'inland-north', 'east-county', 'south-bay'];

const grouped = regionOrder.map((region) => ({
  region,
  label: REGION_LABELS[region],
  locations: LOCATIONS.filter((location) => location.region === region),
}));
---

<Layout
  title="Service Areas | Pool Tidal San Diego"
  description={`Pool Tidal provides pool cleaning, repair, and service across ${LOCATIONS.length} cities and communities in San Diego County.`}
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <span class="text-sm font-semibold uppercase tracking-wide text-primary">Service Areas</span>
    <h1 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">
      Serving {LOCATIONS.length} San Diego County communities
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      From the coast to the inland valleys, Pool Tidal covers pool cleaning, repair, and equipment
      service across San Diego County. Find your city below.
    </p>

    <div class="mt-12 space-y-12">
      {
        grouped.map((group) => (
          <div>
            <h2 class="font-display text-xl font-semibold text-ink">{group.label}</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {group.locations.map((location) => (
                <LocationCard location={location} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <CTASection />
</Layout>
