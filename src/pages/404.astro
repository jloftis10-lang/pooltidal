---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTASection from '../components/CTASection.astro';
import { SERVICES } from '../lib/services';
import { LOCATIONS } from '../lib/locations';

const popularLocations = LOCATIONS.slice(0, 6);
---

<Layout
  title="Page Not Found | Pool Tidal"
  description="The page you're looking for doesn't exist. Find pool cleaning, repair, and service information across San Diego County."
>
  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <span class="text-sm font-semibold uppercase tracking-wide text-primary">404</span>
    <h1 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">
      We couldn't find that page
    </h1>
    <p class="mt-4 text-lg text-muted">
      The link might be broken or the page may have moved. Here are a few places to go instead.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark"
      >
        Back to Home
      </a>
      <a
        href="/contact"
        class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink hover:border-primary hover:text-primary"
      >
        Contact Us
      </a>
    </div>

    <div class="mt-16 grid gap-8 text-left sm:grid-cols-2">
      <div>
        <h2 class="flex items-center gap-2 font-display text-lg font-semibold text-ink">
          <Icon name="wrench" class="h-5 w-5 text-primary" />
          Services
        </h2>
        <ul class="mt-3 space-y-2">
          {
            SERVICES.map((service) => (
              <li>
                <a href={`/services/${service.slug}`} class="text-sm text-muted hover:text-primary">
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="flex items-center gap-2 font-display text-lg font-semibold text-ink">
          <Icon name="map-pin" class="h-5 w-5 text-primary" />
          Service Areas
        </h2>
        <ul class="mt-3 space-y-2">
          {
            popularLocations.map((location) => (
              <li>
                <a href={`/locations/${location.slug}`} class="text-sm text-muted hover:text-primary">
                  {location.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/locations" class="mt-3 inline-block text-sm font-medium text-primary hover:text-primary-dark">
          View all {LOCATIONS.length} areas &rarr;
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
